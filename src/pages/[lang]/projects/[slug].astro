---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { useTranslations, getLangFromUrl } from '@/i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/atoms/button.astro'
import CloseIcon from '@/components/atoms/icons/close-icon.astro'

const projectImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/images/projects/*.{png,jpg,jpeg,webp}',
	{ eager: true }
)

export const getStaticPaths = (async () => {
	const projects = await getCollection('projects')

	return projects.map(project => ({
		params: {
			lang: project.data.lang,
			slug: project.data.slug,
		},
		props: { project },
	}))
}) satisfies GetStaticPaths

const { project } = Astro.props
const projectImages = project.data.image
	.map(imagePath => projectImageModules[`/${imagePath}`]?.default)
	.filter((image): image is ImageMetadata => image !== undefined)
const longDescriptionBlocks = project.data.longDescription
	.split(/\n{2,}/)
	.map(block => block.trim())
	.filter(Boolean)
---

<Layout
	title={project.data.title}
	heading={project.data.title}
	subHeading={project.data.subtitle}
	metadescription={project.data.metaDescription}
>
	<Button
		as='a'
		variant='go-back'
		href={`/${project.data.lang}/projects`}
		slot='title-waves'
		className='text-dark dark:text-light/80!'
	>
		&larr; {t('projects.backToProjects')}
	</Button>

	<article class='flex flex-col lg:flex-row justify-between gap-20 max-w-none'>
		<div class='flex flex-col flex-1 gap-16'>
			<div class='flex flex-col gap-5 text-dark/80 dark:text-light/70'>
				{longDescriptionBlocks.map(block => <p>{block}</p>)}
			</div>
			<div class='flex flex-col gap-2'>
				{
					project.data.url ? (
						<Button
							as='a'
							variant='go-back'
							href={project.data.url}
							slot='title-waves'
							className='text-dark dark:text-light/80!'
							target='_blank'
						>
							{t('projects.liveWebsite')} &rarr;
						</Button>
					) : null
				}
				<ul class='flex gap-2 text-accent-2 dark:text-light/60 text-md! font-semibold flex-wrap'>
					{
						project.data.tags.map(tag => (
							<li>{tag}</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class='flex flex-col gap-6 w-full max-w-80'>
			{
				projectImages.map(image => (
					<Image
						src={image}
						alt={`Illustration from the ${project.data.title} project`}
						class='project-image w-full h-auto cursor-pointer'
					/>
				))
			}
		</div>
		<!-- <Content /> -->
	</article>

	<!-- </HeadingTextBlock> -->
	<div
		class='fixed inset-0 mt-17! z-100 overflow-y-auto hidden min-h-screen bg-light'
		id='full-image-modal'
	>
		<button
			id='full-image-close'
			type='button'
			aria-label='Close full image'
			class='fixed top-20 right-10 z-70 bg-light/40 text-dark rounded-full p-2 cursor-pointer'
		>
			<CloseIcon />
		</button>
		<img
			src=''
			alt=''
			class='w-full z-30'
			id='full-image'
		/>
	</div>
</Layout>

<script>
	function initFullImageModal() {
		const images = document.querySelectorAll<HTMLImageElement>('.project-image')
		const fullImage = document.querySelector<HTMLImageElement>('#full-image')
		const fullImageModal =
			document.querySelector<HTMLElement>('#full-image-modal')
		const closeButton =
			document.querySelector<HTMLButtonElement>('#full-image-close')

		if (!fullImage || !fullImageModal || !closeButton) return
		const modalImage = fullImage
		const modal = fullImageModal
		const modalCloseButton = closeButton

		function openModal(image: HTMLImageElement) {
			modalImage.src = image.currentSrc || image.src
			modalImage.alt = image.alt
			modal.classList.remove('hidden')
		}

		function closeModal() {
			modal.classList.add('hidden')
			modalImage.removeAttribute('src')
			modalImage.alt = ''
		}

		images.forEach(image =>
			image.addEventListener('click', () => {
				openModal(image)
			})
		)

		modalCloseButton.addEventListener('click', closeModal)
		document.addEventListener('keydown', event => {
			if (event.key === 'Escape') closeModal()
		})
	}

	document.addEventListener('astro:page-load', initFullImageModal)
</script>
