---
import { useTranslations, getLangFromUrl } from '@/i18n/utils'
const lang = getLangFromUrl(Astro.url)
import { cn } from '@/utils/cn'
import { ClientRouter } from 'astro:transitions'
import Header from '@/components/organisms/header.astro'
import Footer from '@/components/organisms/footer.astro'
import Hero from '@/components/organisms/hero.astro'
import TitleWaves from '@/components/organisms/title-waves.astro'

const t = useTranslations(lang)

interface Props {
	heading?: string
	isHome?: boolean
	subHeading?: string
	title: string
	titleWavesVariant?: 'small' | 'full'
	className?: string
	metadescription?: string
}
import '../styles/global.css'

const {
	className,
	isHome,
	metadescription,
	title,
	titleWavesVariant = 'full',
	heading,
	subHeading,
} = Astro.props
---

<!doctype html>
<html lang={lang} class='dark' data-theme='dark'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='generator' content={Astro.generator} />
		<title>Dominik Frackowiak | {title}</title>
		<meta name='description' content={metadescription} />
		<ClientRouter />
	</head>
	<body class='flex min-h-screen flex-col bg-light dark:bg-dark'>
		<Header />
		{
			isHome ? (
				<Hero
					copy1={t('hero.hello1')}
					copy2={t('hero.hello2')}
					copy3={t('hero.hello3')}
					contactButtonContent={t('hero.btn.contact')}
					viewProjectsButtonContent={t('hero.btn.viewProjects')}
				/>
			) : (
				<TitleWaves
					variant={titleWavesVariant}
					heading={heading}
					subHeading={subHeading}
				>
					<slot name='title-waves' slot='title-waves' />
				</TitleWaves>
			)
		}
		<main
			class={cn(
				'flex flex-col flex-1 gap-16 w-full max-w-6xl mx-auto px-4  mb-24 z-10',
				isHome ? 'mt-16' : 'mt-24 md:mt-8',
				className
			)}
		>
			<slot />
		</main>

		<Footer />
	</body>
</html>
