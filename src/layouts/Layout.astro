---
import { useTranslations, getLangFromUrl } from '@/i18n/utils'
const lang = getLangFromUrl(Astro.url)
import { cn } from '@/utils/cn'
import { ClientRouter } from 'astro:transitions'
import Header from '@/components/organisms/header.astro'
import Footer from '@/components/organisms/footer.astro'
import Hero from '@/components/organisms/hero.astro'
import TitleWaves from '@/components/organisms/title-waves.astro'
import Waves from '@/components/atoms/waves-2.astro'

const t = useTranslations(lang)

interface Props {
	heading?: string
	isHome?: boolean
	subHeading?: string
	title: string
	titleWavesVariant?: 'small' | 'full'
	className?: string
	metadescription?: string
}
import '../styles/global.css'

const {
	className,
	isHome,
	metadescription,
	title,
	titleWavesVariant = 'full',
	heading,
	subHeading,
} = Astro.props
---

<!doctype html>
<html lang={lang} class='dark' data-theme='dark'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' href='/favicon.png' />
		<meta name='generator' content={Astro.generator} />
		<title>Dominik Frackowiak | {title}</title>
		<meta name='description' content={metadescription} />
		<ClientRouter />
	</head>
	<body
		class='flex min-h-screen flex-col bg-light dark:bg-dark overflow-x-hidden'
	>
		<Header />
		{
			isHome ? (
				<Hero
					copy1={t('hero.hello1')}
					copy2={t('hero.hello2')}
					copy3={t('hero.hello3')}
					contactButtonContent={t('hero.btn.contact')}
					viewProjectsButtonContent={t('hero.btn.viewProjects')}
					locale={lang}
				/>
			) : (
				<TitleWaves
					variant={titleWavesVariant}
					heading={heading}
					subHeading={subHeading}
				>
					<slot name='title-waves' slot='title-waves' />
				</TitleWaves>
			)
		}
		<main
			class={cn(
				'flex flex-col flex-1 gap-16 w-full max-w-6xl mx-auto px-4  mb-16 z-10',
				isHome ? 'mt-4' : 'mt-16 md:mt-8',
				className
			)}
		>
			<slot />
		</main>
		<div
			class={cn(
				'relative bottom-0 left-0 right-0 z-0 h-40 w-full overflow-hidden',
				isHome ? 'block' : 'hidden'
			)}
		>
			<Waves
				class={cn(
					'absolute top-0 left-0 h-full w-full rotate-180',
					isHome
						? 'text-accent-2 [--waves-2-line-gap-scale:3]'
						: 'text-transparent h-0'
				)}
				strokeWidth={0.5}
			/>
			<div
				class={cn(
					'absolute top-0 left-0 z-5 h-full w-full bg-linear-to-b',
					isHome
						? 'from-light to-light/60 dark:from-transparent dark:to-transparent'
						: 'from-dark/60 to-dark'
				)}
			>
			</div>
		</div>
		<Footer />
	</body>
</html>
