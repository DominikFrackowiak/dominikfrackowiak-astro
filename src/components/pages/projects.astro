---
import { getCollection } from 'astro:content'
import { useTranslations, getLangFromUrl } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)

import Layout from '../../layouts/Layout.astro'
import HeadingTextBlock from '../organisms/heading-text-block.astro'
import Button from '../atoms/button.astro'

const t = useTranslations(lang)

const projectImageModules = import.meta.glob<string>(
	'/src/assets/images/projects/*.{png,jpg,jpeg,webp}',
	{ eager: true, import: 'default', query: '?url' }
)

const projects = await getCollection(
	'projects',
	({ data }) => data.lang === lang
)

const projectsWithThumbnails = projects.map(project => ({
	...project,
	thumbnailUrl: projectImageModules[`/${project.data.image[0]}`],
}))
---

<Layout
	title={t('projects.title')}
	heading={t('projects.title')}
	subHeading={t('projects.subHeading')}
	metadescription={t('projects.metadescription')}
>
	{
		projectsWithThumbnails.map(item => (
			<a
				href={`/${item.data.lang}/projects/${item.data.slug}`}
				class='flex flex-col md:flex-row gap-8 justify-between items-start w-full z-50'
			>
				<HeadingTextBlock
					headingText={item.data.title}
					headingClassName='no-underline!'
					className='gap-4 order-1 md:order-0'
				>
					<div class='flex flex-col gap-4 lg:gap-2.5'>
						<p>{item.data.shortDescription.slice(0, 80)}...</p>
						<div
							class='flex lg:hidden w-40 h-40 shrink-0 bg-cover bg-start md:bg-center order-0 md:order-1 bg-no-repeat'
							style={
								item.thumbnailUrl
									? `background-image: url('${item.thumbnailUrl}')`
									: undefined
							}
						/>
						<Button variant='go-back' className='self-start'>
							{t('projects.viewProject')} &rarr;
						</Button>
					</div>
					<div class='flex gap-2'>
						<ul class='flex gap-2 text-dark/80 dark:text-light/60 text-md! font-light flex-wrap'>
							{item.data.tags.map(el => (
								<li>{el}</li>
							))}
						</ul>
					</div>
				</HeadingTextBlock>
				<div
					class='hidden lg:flex w-full h-45 md:w-20 md:h-20 shrink-0 bg-cover bg-start md:bg-center order-0 md:order-1 bg-no-repeat'
					style={
						item.thumbnailUrl
							? `background-image: url('${item.thumbnailUrl}')`
							: undefined
					}
				/>
			</a>
		))
	}
</Layout>
