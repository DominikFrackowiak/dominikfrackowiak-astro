---
import Layout from '@/layouts/Layout.astro'
import Button from '../atoms/button.astro'
import Heading from '../atoms/heading.astro'
import Modal from '../organisms/modal.astro'
import TitleWaves from '../organisms/title-waves.astro'

const locale = Astro.currentLocale ?? 'en'

const baseUrl = import.meta.env.DEV
	? 'http://localhost:4321'
	: 'https://dominikfrackowiak.com'

const redirectUrl = `${baseUrl}/${locale}/contact?messageSent=true`
const contactUrl = `/${locale}/contact`
const homeUrl = `/${locale}`
---

<!-- <TitleWaves>
	<Heading as='h1'>CONTACT</Heading>
	<p>
		Disponible para proyectos frontend, colaboraciones y trabajo freelance
		selectivo.
	</p>
</TitleWaves> -->
<Layout
	title='Contact'
	heading='CONTACT ME'
	subHeading='FEEL FREE TO CONTACT ME'
>
	<div class='flex flex-col md:flex-row justify-between items-start gap-16'>
		<div class='flex flex-col gap-4 w-full md:w-1/2'>
			<form
				action='https://api.web3forms.com/submit'
				method='POST'
				class='flex flex-col items-start w-full max-w-80 gap-5'
				id='contact'
			>
				<input type='hidden' name='redirect' value={redirectUrl} />
				<input
					type='hidden'
					name='access_key'
					value={import.meta.env.PUBLIC_WEB3FORMS_KEY}
				/>
				<div class='flex flex-col gap-2 w-full'>
					<label for='name'>Name:</label>
					<input type='text' name='name' required id='name' />
				</div>
				<div class='flex flex-col gap-2 w-full'>
					<label for='email'>E-mail:</label>
					<input type='email' name='email' required id='email' />
				</div>
				<div class='flex flex-col gap-2 w-full'>
					<label for='message'>Message:</label>
					<textarea name='message' required id='message'></textarea>
				</div>
				<!-- <div class='h-19.5 w-76 origin-top-left scale-[0.7]'>
			<div class='h-captcha h-full' data-captcha='true'></div>
		</div> -->

				<Button type='submit' className='mt-4'>Sent the message</Button>
			</form>
		</div>
		<div
			class='flex flex-col justify-center items-start translate-x-0 lg:translate-x-1/2 gap-4 w-full md:w-1/2'
		>
			<Button
				as='a'
				variant='go-back'
				href='https://www.linkedin.com/in/dominik-frackowiak'
				target='_blank'
			>
				<span class='tracking-heading'>LinkedIn &rarr;</span>
			</Button>
			<Button
				as='a'
				variant='go-back'
				href='https://github.com/DominikFrackowiak'
				target='_blank'
			>
				<span class='tracking-heading'>Github &rarr;</span>
			</Button>
			<Button
				as='a'
				variant='go-back'
				href='https://codepen.io/MarianKoniuszko/pens/popular'
				target='_blank'
			>
				<span class='tracking-heading'>Codepen &rarr;</span>
			</Button>
			<Button
				as='a'
				variant='go-back'
				href='mailto:dominikfrac@gmail.com'
				target='_blank'
			>
				<span class='tracking-heading'>E-mail &rarr;</span>
			</Button>
			<Button
				as='a'
				variant='go-back'
				href='https://wa.me/34654114393?text=Hello'
				target='_blank'
			>
				<span class='tracking-heading'>WhatsApp &rarr;</span>
			</Button>
		</div>
	</div>
	<Modal closeHref={contactUrl} homeHref={homeUrl} />
</Layout>

<!-- -- Step 2: Add the Web3Forms script ---->
<script src='https://web3forms.com/client/script.js' async defer></script>
<script>
	const form = document.querySelector<HTMLFormElement>('#contact')
	const successModal = document.querySelector<HTMLElement>(
		'#contact-success-modal'
	)

	const searchParams = new URLSearchParams(window.location.search)
	const wasMessageSent = searchParams.get('messageSent') === 'true'

	if (wasMessageSent) {
		successModal?.removeAttribute('hidden')
	}

	form?.addEventListener('submit', function (e) {
		const captcha = form.querySelector<HTMLElement>('[data-captcha]')
		const captchaFrame = captcha?.querySelector('iframe')
		const captchaResponse = form.querySelector<HTMLTextAreaElement>(
			'textarea[name="h-captcha-response"]'
		)

		if (!captchaFrame) {
			e.preventDefault()
			alert('Captcha is still loading. Please try again in a moment.')
			return
		}

		if (!captchaResponse || !captchaResponse.value) {
			e.preventDefault()
			alert('Please complete the captcha before sending.')
		}
	})
</script>
