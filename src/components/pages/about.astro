---
import { useTranslations, getLangFromUrl } from '@/i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
import Layout from '@/layouts/Layout.astro'

import HeadingTextBlock from '../organisms/heading-text-block.astro'
---

<Layout
	title={t('about.title')}
	heading={t('about.title')}
	subHeading={t('about.subHeading')}
	metadescription={t('about.metadescription')}
>
	<p>
		{t('about.intro')}
	</p>

	<HeadingTextBlock headingText={t('about.hobbies.title')}>
		<p>{t('about.hobbies.text')}</p>
	</HeadingTextBlock>
	<HeadingTextBlock headingText={t('about.music.title')}>
		<p>{t('about.music')}</p>
	</HeadingTextBlock>
	<HeadingTextBlock headingText={t('about.film.title')}>
		<p>{t('about.film')}</p>
	</HeadingTextBlock>
</Layout>
