---
import { cn } from '@/utils/cn'
import type { HTMLAttributes } from 'astro/types'

const buttonVariants = {
	'icon-button': 'text-light text-2xl border-none',
	regular:
		'text-dark dark:text-light border border-dark dark:border-light rounded-4xl px-3 py-1.5 text-sm hover:opacity-85',
	cta: 'text-light border border-accent bg-accent dark:border-accent rounded-4xl px-3 py-1.5 text-sm hover:opacity-85',
	'go-back': 'text-md border-none text-md text-accent/80',
	simple: 'text-md border-none text-dark/60 dark:text-light/60',
} as const

type ButtonVariant = keyof typeof buttonVariants
type ButtonTag = 'button' | 'a'

type Props = {
	className?: string
	variant?: ButtonVariant
	as?: ButtonTag
	href?: string
	type?: 'button' | 'submit'
	cb?: () => void
} & (HTMLAttributes<'button'> | HTMLAttributes<'a'>)

const {
	className,
	variant = 'regular',
	type,
	cb,
	as = 'button',
	href,
	...props
} = Astro.props as Props
const Tag = as
---

<Tag
	{...props}
	class={cn('cursor-pointer', buttonVariants[variant], className)}
	href={href}
	type={type}
>
	<slot />
</Tag>
