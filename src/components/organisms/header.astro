---
import { getLangFromUrl } from '@/i18n/utils'
import Logo from '@/components/atoms/logo.astro'

import ScrollIndicator from '../molecules/scroll-indicator.astro'
// import HeaderActions from './header-actions.astro'
import Dropdown from '../molecules/dropdown.astro'
import EarthIcon from '../atoms/icons/earth-icon.astro'
import HamburgerIcon from '../atoms/icons/hamburger-icon.astro'
import ThemePicker from '../molecules/theme-picker.astro'
import Navigation from '../molecules/navigation.astro'
import NavigationMobile from '../molecules/navigation-mobile.astro'
const lang = getLangFromUrl(Astro.url)
const currentPath = Astro.url.pathname

function getNewPath(newLocale: string) {
	const parts = currentPath.split('/')
	parts.splice(1, 1, newLocale)
	const newPath = parts.join('/')
	return newPath
}
---

<header class='fixed top-0 left-0 z-50 w-full bg-dark dark:bg-accent py-4'>
	<ScrollIndicator />
	<div class='flex justify-between max-w-6xl mx-auto items-center px-4'>
		<Logo />

		<div class='flex items-center gap-4 md:gap-7 h-full'>
			<Navigation />
			<ThemePicker />
			<Dropdown>
				<EarthIcon slot='trigger' />
				<ul class='flex flex-col gap-2'>
					<li>
						<a
							href={getNewPath('en')}
							class='text-dark! dark:text-light! font-light! hover:[text-shadow:0_0_0_currentColor] uppercase tracking-heading'
							>English</a
						>
					</li><li>
						<a
							href={getNewPath('pl')}
							class='text-dark! dark:text-light! font-light! hover:[text-shadow:0_0_0_currentColor] uppercase tracking-heading'
							>Polski</a
						>
					</li><li>
						<a
							href={getNewPath('es')}
							class='text-dark! dark:text-light! font-light! hover:[text-shadow:0_0_0_currentColor] uppercase tracking-heading'
							>Español</a
						>
					</li>
				</ul>
			</Dropdown>
			<Dropdown wrapperClassName='flex lg:hidden'>
				<HamburgerIcon slot='trigger' />
				<NavigationMobile />
			</Dropdown>
		</div>
	</div>
</header>
