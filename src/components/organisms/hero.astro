---
import Image from 'astro/components/Image.astro'
import portrait from '@/assets/images/dominikfrackowiak2.webp'
import Button from '../atoms/button.astro'
import CenteringWrapper from '../atoms/centering-wrapper.astro'
import Waves from '../atoms/waves-2.astro'

interface Props {
	contactButtonContent: string
	viewProjectsButtonContent: string
	copy1: string
	copy2: string
	copy3: string
	locale?: 'es' | 'en' | 'pl'
}

const {
	contactButtonContent,
	viewProjectsButtonContent,
	copy1,
	copy2,
	copy3,
	locale = 'en',
} = Astro.props
---

<section
	class='flex w-full gap-20 pb-20 md:pb-40 waves-bg relative isolate overflow-hidden pt-10 md:pt-20'
>
	<Waves
		class='absolute inset-0 z-0 h-full w-full text-dark dark:text-accent'
		animated
		strokeWidth={0.7}
		lineGapScale={1.12}
	/>
	<div
		class='absolute inset-0 z-1 h-full w-full bg-linear-to-b from-light/85 to-light dark:from-dark/30 dark:to-dark'
	>
	</div>
	<CenteringWrapper
		className='flex flex-col lg:flex-row justify-between items-start pt-20 relative z-10 gap-8 px-4'
	>
		<div class='flex justify-start w-full md:w-2/6'>
			<Image
				src={portrait}
				alt="Dominik's Frackowiak portrait"
				class='h-34 lg:h-48 w-34 lg:w-48 rounded-full lg:mt-2'
			/>
		</div>
		<div class='flex flex-col gap-6 w-full lg:w-3/5 pt-5'>
			<p
				class='flex flex-col gap-3 md:gap-2 text-dark dark:text-light text-left lg:text-justify text-hero! leading-6 dark:leading-8! font-normal! dark:font-light! uppercase tracking-heading'
			>
				<span>{copy1}</span>
				<span>{copy2}</span>
				<span>{copy3}</span>
			</p>

			<div class='flex w-full gap-4 md:gap-3 justify-start lg:justify-end'>
				<Button as='a' variant='regular' href=`/${locale}/contact`
					>{contactButtonContent}</Button
				>
				<Button as='a' variant='cta' href=`/${locale}/projects`
					>{viewProjectsButtonContent}</Button
				>
			</div>
		</div>
	</CenteringWrapper>
</section>
