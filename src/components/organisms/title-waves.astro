---
import { cn } from '@/utils/cn'
import Waves from '../atoms/waves-2.astro'
import Heading from '../atoms/heading.astro'

const variants = {
	full: 'min-h-56 md:min-h-80',
	small: 'h-36 md:h-28',
} as const

type Variant = keyof typeof variants

interface Props {
	className?: string
	variant?: Variant
	heading?: string
	subHeading?: string
	as?: 'span' | 'h3' | 'p'
}

const {
	as = 'h3',
	className,
	heading,
	variant = 'full',
	subHeading,
}: Props = Astro.props

const Tag = as
---

<div
	class={cn(
		'relative top-16.5 left-0 w-full overflow-hidden lg:my-0 py-20! ',
		variants[variant],
		className
	)}
>
	<Waves
		class='absolute -inset-y-10 md:inset-0 h-full w-full text-dark dark:text-accent [--waves-2-line-gap-scale:3] md:[--waves-2-line-gap-scale:1]'
	/>

	<div
		class='flex justify-end items-center absolute top-0 left-0 h-full w-full bg-linear-to-b from-light/80 dark:from-dark/60 to-light dark:to-dark'
	>
		<div
			class='flex flex-col justify-center items-start w-full max-w-6xl mx-auto h-full px-4 gap-4 py-16!'
		>
			{
				heading && (
					<Heading
						as='h1'
						className='text-heading-one font-semibold! tracking-heading'
					>
						{heading}
					</Heading>
				)
			}

			{
				subHeading && (
					<Tag class='uppercase text-dark! dark:text-light/80! tracking-heading'>
						{subHeading}
					</Tag>
				)
			}

			<slot name='title-waves' />
		</div>
	</div>
</div>
