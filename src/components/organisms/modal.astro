---
import Button from '../atoms/button.astro'

interface Props {
	closeHref: string
	homeHref: string
}

const { closeHref, homeHref } = Astro.props
---

<div
	id='contact-success-modal'
	class='fixed inset-0 z-50 flex items-center justify-center bg-dark/70 px-5'
	role='dialog'
	aria-modal='true'
	aria-labelledby='contact-success-title'
	hidden
>
	<div
		class='flex w-full max-w-90 flex-col items-start gap-6 bg-light p-8 shadow-xl dark:bg-darker/70'
	>
		<div class='flex flex-col gap-3'>
			<h2
				id='contact-success-title'
				class='text-dark uppercase dark:text-light font-light tracking-heading text-xl underline underline-offset-10 decoration-accent decoration-1'
			>
				Message sent
			</h2>
			<p>Thank you for your message. I will get back to you soon.</p>
		</div>
		<div class='flex flex-wrap gap-3'>
			<Button as='a' href={closeHref}>Close</Button>
			<Button as='a' href={homeHref} variant='cta'>Home page</Button>
		</div>
	</div>
</div>
