---
import { cn } from '@/utils/cn'
import Heading from '../atoms/heading.astro'

interface Props {
	headingText: string
	className?: string
	headingClassName?: string
	headingVariant?: 'h1' | 'h2'
}

const {
	headingText,
	headingClassName,
	headingVariant = 'h2',
	className,
} = Astro.props
---

<article class={cn('flex flex-col gap-10', className)}>
	<Heading className={headingClassName} variant={headingVariant}
		>{headingText}</Heading
	>

	<slot />
</article>
