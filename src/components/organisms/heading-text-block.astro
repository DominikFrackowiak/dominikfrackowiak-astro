---
import { cn } from '@/utils/cn'
import CenteringWrapper from '../atoms/centering-wrapper.astro'
import Heading from '../atoms/heading.astro'

interface Props {
	headingText: string
	className?: string
	headingClassName?: string
}

const { headingText, headingClassName, className } = Astro.props
---

<CenteringWrapper className={cn('flex-col gap-10 py-8!', className)}>
	<Heading className={headingClassName}>{headingText}</Heading>
	<!-- <Technologies /> -->
	<slot />
</CenteringWrapper>
