<div class='fixed top-0 left-0 w-full h-0.5 bg-dark dark:bg-accent'>
	<div class='scroll-indicator absolute top-0 left-0 h-full bg-custom-gray'>
	</div>
</div>

<script>
	function updateScrollIndicators() {
		const scrollIndicators = document.querySelectorAll('.scroll-indicator')
		const documentHeight =
			document.documentElement.scrollHeight - window.innerHeight
		const scrollProgress =
			documentHeight > 0 ? (window.scrollY / documentHeight) * 100 : 0

		scrollIndicators.forEach(scrollIndicator => {
			if (scrollIndicator instanceof HTMLElement) {
				scrollIndicator.style.width = `${scrollProgress}%`
			}
		})
	}

	function initScrollIndicator() {
		updateScrollIndicators()

		if (document.documentElement.dataset.scrollIndicatorBound === 'true') {
			return
		}

		document.documentElement.dataset.scrollIndicatorBound = 'true'
		document.addEventListener('scroll', updateScrollIndicators, { passive: true })
		window.addEventListener('resize', updateScrollIndicators)
		document.addEventListener('astro:page-load', updateScrollIndicators)
	}

	initScrollIndicator()
	document.addEventListener('astro:page-load', initScrollIndicator)
</script>
