---
interface Props {
	company: string
	position: string
	description: string
	technologies: readonly string[]
}

const { company, position, description, technologies } = Astro.props
---

<article class='flex flex-col gap-6'>
	<div class='flex flex-col gap-4'>
		<header
			class='flex flex-col gap-1 md:flex-row items-start md:items-center justify-between text-accent'
		>
			<h3 class='uppercase'>{company}</h3>
			<p class='text-list! text-accent!'>{position}</p>
		</header>

		<p>
			{description}
		</p>
	</div>
	<ul
		class='flex gap-2 text-accent-2 dark:text-light/60 text-md! font-semibold flex-wrap'
	>
		{technologies.map(el => <li>{el}</li>)}
	</ul>
</article>
